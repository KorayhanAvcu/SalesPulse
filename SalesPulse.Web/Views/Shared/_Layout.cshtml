@{
    // Hangi menü aktif? Adres çubuğundaki controller adına bakıyoruz (Dashboard / Orders / Sales)
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    string Active(string name) => controller == name ? "active" : "";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · SalesPulse</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- ================= SOL MENÜ (sabit) ================= -->
    <aside class="sp-sidebar">
        <a class="sp-brand" asp-controller="Dashboard" asp-action="Index">
            <span class="sp-brand-mark">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 12 7 12 10 4 14 20 17 12 21 12" /></svg>
            </span>
            SalesPulse
        </a>

        <nav class="sp-nav">
            <div class="sp-nav-label">Menü</div>

            <a class="@Active("Dashboard")" asp-controller="Dashboard" asp-action="Index">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9" rx="1.5" /><rect x="14" y="3" width="7" height="5" rx="1.5" /><rect x="14" y="12" width="7" height="9" rx="1.5" /><rect x="3" y="16" width="7" height="5" rx="1.5" /></svg>
                Dashboard
            </a>
            <a class="@Active("Orders")" asp-controller="Orders" asp-action="Index">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z" /><line x1="3" y1="6" x2="21" y2="6" /><path d="M16 10a4 4 0 0 1-8 0" /></svg>
                Sipariş Yönetimi
            </a>
            <a class="@Active("Sales")" asp-controller="Sales" asp-action="Index">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10" /><line x1="12" y1="20" x2="12" y2="4" /><line x1="6" y1="20" x2="6" y2="14" /></svg>
                Satış Analizi
            </a>
        </nav>

        <div class="sp-sidebar-foot">
            <strong>Veri dönemi</strong>
            Ocak 2024 – Ekim 2026<br />2 milyon+ sipariş
        </div>
    </aside>

    <div class="sp-main">
        <!-- ================= ÜST BAR: arama, bildirim, profil ================= -->
        <header class="sp-topbar">
            <button class="sp-icon-btn sp-menu-toggle" type="button" aria-label="Menüyü aç">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6" /><line x1="3" y1="12" x2="21" y2="12" /><line x1="3" y1="18" x2="21" y2="18" /></svg>
            </button>

            <form id="globalSearch" class="sp-search" role="search">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
                <input type="search" placeholder="Sipariş no veya müşteri ara…" aria-label="Sipariş ara" />
            </form>

            <div class="sp-topbar-right">
                <div class="dropdown">
                    <button class="sp-icon-btn" type="button" data-bs-toggle="dropdown" aria-label="Bildirimler">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" /><path d="M13.73 21a2 2 0 0 1-3.46 0" /></svg>
                        <span class="sp-dot"></span>
                    </button>
                    <div class="dropdown-menu dropdown-menu-end p-3" style="width:280px">
                        <div class="fw-semibold mb-2">Bildirimler</div>
                        <div class="text-muted small">Yeni bildirim yok.</div>
                    </div>
                </div>

                <div class="sp-profile">
                    <span class="sp-avatar">KA</span>
                    <div>
                        <strong>Korayhan A.</strong>
                        <small>Yönetici</small>
                    </div>
                </div>
            </div>
        </header>

        <!-- ================= SAYFA İÇERİĞİ ================= -->
        <main class="sp-content">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
